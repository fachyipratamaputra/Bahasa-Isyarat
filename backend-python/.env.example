PORT=3000

# Salin connection string PostgreSQL dari Supabase / Neon / Render.
# Format: postgresql://USER:PASSWORD@HOST:5432/NAMA_DB?sslmode=require
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/signbridge

# Teks acak panjang (min. 32 karakter). Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GANTI_DENGAN_TEKS_ACAK_PANJANG
JWT_EXPIRES_DAYS=7

# Alamat website frontend yang boleh mengakses API (pisahkan dengan koma).
# Kosongkan / isi * saat development.
CORS_ORIGINS=*

# 1 = mode debug (hanya di laptop). Jangan aktifkan di server online.
FLASK_DEBUG=0
